<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity OrderLeg.
    -->
    <changeSet id="20260811151706-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="order_id"
                                 baseTableName="order_leg"
                                 constraintName="fk_order_leg__order_id"
                                 referencedColumnNames="id"
                                 referencedTableName="shipment_order"
                                 />

        <addForeignKeyConstraint baseColumnNames="from_office_id"
                                 baseTableName="order_leg"
                                 constraintName="fk_order_leg__from_office_id"
                                 referencedColumnNames="id"
                                 referencedTableName="office"
                                 />

        <addForeignKeyConstraint baseColumnNames="to_office_id"
                                 baseTableName="order_leg"
                                 constraintName="fk_order_leg__to_office_id"
                                 referencedColumnNames="id"
                                 referencedTableName="office"
                                 />

        <addForeignKeyConstraint baseColumnNames="trip_id"
                                 baseTableName="order_leg"
                                 constraintName="fk_order_leg__trip_id"
                                 referencedColumnNames="id"
                                 referencedTableName="trip"
                                 />
    </changeSet>
</databaseChangeLog>
