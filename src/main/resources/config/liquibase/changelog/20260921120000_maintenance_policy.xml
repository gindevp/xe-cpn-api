<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260921120000-1" author="cpn">
        <comment>
            Chính sách bảo trì hệ thống — bảng singleton (1 row).
            Bảng rỗng / enabled=false = không chặn kênh nào.
            Kênh: app NV, app KH, web NV, web KH; block_all = cả bốn.
        </comment>
        <createTable tableName="maintenance_policy">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="enabled" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="block_all" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="block_app_staff" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="block_app_customer" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="block_web_staff" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="block_web_customer" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="varchar(200)"/>
            <column name="message" type="varchar(2000)"/>
            <column name="image_url" type="longtext"/>
            <column name="updated_at" type="${datetimeType}"/>
        </createTable>
    </changeSet>
</databaseChangeLog>
