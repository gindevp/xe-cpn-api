<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20261008100000-scan-voice" author="cpn">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="scan_voice"/>
            </not>
        </preConditions>
        <comment>Giọng quét tùy chỉnh (Được/Sai). Trống = app dùng file mặc định trong bản cài.</comment>
        <createTable tableName="scan_voice">
            <column name="voice_type" type="varchar(16)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="content_type" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="etag" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="file_name" type="varchar(255)"/>
            <column name="byte_size" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="content" type="${blobType}">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="${datetimeType}">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
