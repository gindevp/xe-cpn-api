<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260911140000-1" author="cpn">
        <comment>Thông tin xuất hoá đơn trên shipment_order</comment>
        <addColumn tableName="shipment_order">
            <column name="invoice_requested" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="invoice_tax_code" type="varchar(20)"/>
            <column name="invoice_company_name" type="varchar(200)"/>
            <column name="invoice_email" type="varchar(120)"/>
            <column name="invoice_company_address" type="varchar(255)"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
