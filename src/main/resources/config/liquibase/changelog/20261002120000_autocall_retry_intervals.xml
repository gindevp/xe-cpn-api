<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20261002120000-1" author="cpn">
        <comment>
            Auto Call gọi lại: khoảng cách riêng cho từng lần ("60,120"), đếm tổng số lần trên mọi ngày;
            cuộc rơi ngoài khung giờ dời sang đầu khung hôm sau. Bỏ số lần/khoảng cách cố định và số ngày.
        </comment>
        <addColumn tableName="integration_config">
            <column name="autocall_retry_intervals" type="varchar(100)" defaultValue="60,120"/>
        </addColumn>
        <dropColumn tableName="integration_config" columnName="autocall_retry_max"/>
        <dropColumn tableName="integration_config" columnName="autocall_retry_interval_min"/>
        <dropColumn tableName="integration_config" columnName="autocall_retry_next_day"/>
        <dropColumn tableName="integration_config" columnName="autocall_retry_max_days"/>
    </changeSet>
</databaseChangeLog>
