<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20261008110000-invoice-buyer-id-phone" author="cpn">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="shipment_order" columnName="invoice_buyer_id_number"/>
            </not>
        </preConditions>
        <comment>CCCD/CMND và SĐT người trên hóa đơn (không bắt buộc). Có nhập thì truyền sang MISA khi xuất.</comment>
        <addColumn tableName="shipment_order">
            <column name="invoice_buyer_id_number" type="varchar(20)"/>
            <column name="invoice_buyer_phone" type="varchar(20)"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
