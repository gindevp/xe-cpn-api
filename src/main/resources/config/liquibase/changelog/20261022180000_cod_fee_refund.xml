<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20261022180000-cod-fee-refund" author="cpn">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="shipment_order" columnName="cod_fee_refund_amount"/>
            </not>
        </preConditions>
        <comment>Tiền hoàn phí COD khi bỏ/giảm phí thu hộ sau khi đã thu đủ cước (giữ paid_amount).</comment>
        <addColumn tableName="shipment_order">
            <column name="cod_fee_refund_amount" type="decimal(21,2)"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
