<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260925100000-1" author="cpn">
        <comment>Giờ tự đăng xuất (giờ Việt Nam). Mặc định 21:00, bật.</comment>
        <createTable tableName="session_policy">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="enabled" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="logout_time" type="varchar(5)" defaultValue="21:00">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="${datetimeType}"/>
        </createTable>
        <insert tableName="session_policy">
            <column name="enabled" valueBoolean="true"/>
            <column name="logout_time" value="21:00"/>
        </insert>
    </changeSet>
</databaseChangeLog>
