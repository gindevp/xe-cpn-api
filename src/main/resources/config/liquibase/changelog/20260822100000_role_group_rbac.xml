<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260822100000-1" author="cpn">
        <createTable tableName="role_group">
            <column name="id" type="bigint" autoIncrement="true" startWith="100">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="varchar(30)">
                <constraints nullable="false" unique="true" uniqueConstraintName="ux_role_group__code"/>
            </column>
            <column name="name" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="varchar(255)"/>
            <!-- Legacy RoleCode used by non-screen logic (office scope, force close, reports). -->
            <column name="base_role_code" type="varchar(10)">
                <constraints nullable="false"/>
            </column>
            <column name="builtin" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="20260822100000-2" author="cpn">
        <createTable tableName="role_group_screen">
            <column name="id" type="bigint" autoIncrement="true" startWith="100">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="role_group_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="screen_key" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="perm_level" type="varchar(1)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint
            tableName="role_group_screen"
            columnNames="role_group_id, screen_key"
            constraintName="ux_role_group_screen__group_screen"/>
        <addForeignKeyConstraint
            baseTableName="role_group_screen"
            baseColumnNames="role_group_id"
            constraintName="fk_role_group_screen__role_group_id"
            referencedTableName="role_group"
            referencedColumnNames="id"
            onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="20260822100000-3" author="cpn">
        <addColumn tableName="staff_profile">
            <column name="role_group_id" type="bigint"/>
        </addColumn>
        <addForeignKeyConstraint
            baseTableName="staff_profile"
            baseColumnNames="role_group_id"
            constraintName="fk_staff_profile__role_group_id"
            referencedTableName="role_group"
            referencedColumnNames="id"/>
    </changeSet>
</databaseChangeLog>
