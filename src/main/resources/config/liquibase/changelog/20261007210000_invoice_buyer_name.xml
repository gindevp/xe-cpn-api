<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20261007210000-invoice-buyer-name" author="cpn">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="shipment_order" columnName="invoice_buyer_name"/>
            </not>
        </preConditions>
        <comment>Tên người ghi trên hóa đơn. Trống thì lúc xuất lấy tên người trả cước.</comment>
        <addColumn tableName="shipment_order">
            <column name="invoice_buyer_name" type="varchar(100)"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
