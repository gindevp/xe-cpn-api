<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260814120000-1" author="cpn">
        <dropNotNullConstraint tableName="pricing_rule" columnName="route_id" columnDataType="bigint"/>
        <addColumn tableName="pricing_rule">
            <column name="branch_id" type="bigint">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        <addForeignKeyConstraint
            baseTableName="pricing_rule"
            baseColumnNames="branch_id"
            constraintName="fk_pricing_rule__branch_id"
            referencedTableName="branch"
            referencedColumnNames="id"/>
    </changeSet>
</databaseChangeLog>
