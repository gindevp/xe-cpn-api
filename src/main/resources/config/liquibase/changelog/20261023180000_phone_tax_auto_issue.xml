<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20261023180000-phone-tax-auto-issue" author="cpn">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="phone_tax_link" columnName="auto_issue"/>
            </not>
        </preConditions>
        <comment>CRM SĐT: tick MST nào được auto xuất HĐ công ty (mặc định bật)</comment>
        <addColumn tableName="phone_tax_link">
            <column name="auto_issue" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <update tableName="phone_tax_link">
            <column name="auto_issue" valueBoolean="true"/>
            <where>auto_issue IS NULL</where>
        </update>
    </changeSet>
</databaseChangeLog>
