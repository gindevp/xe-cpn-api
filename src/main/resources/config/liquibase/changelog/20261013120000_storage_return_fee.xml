<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20261013120000-storage-return-fee" author="cpn">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="shipment_order" columnName="storage_fee_amount"/>
            </not>
        </preConditions>
        <comment>Phí tồn kho giao và phí hoàn — đã cộng vào fare_amount.</comment>
        <addColumn tableName="shipment_order">
            <column name="storage_fee_amount" type="decimal(21,2)"/>
            <column name="return_fee_amount" type="decimal(21,2)"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
