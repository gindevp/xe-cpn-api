<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20261007180000-pod-photo-caption" author="cpn">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="order_pod_photo" columnName="caption"/>
            </not>
        </preConditions>
        <comment>Nhãn ảnh POD: Nhận (tài xế lấy hàng) / Giao (tài xế giao hàng)</comment>
        <addColumn tableName="order_pod_photo">
            <column name="caption" type="varchar(20)"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
