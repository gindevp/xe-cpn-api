<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20261004110000-1" author="cpn">
        <comment>Lộ trình VP báo giờ xe đến/đi. VP chưa cấu hình = mọi lộ trình có điểm đầu/cuối là điểm của VP.</comment>
        <createTable tableName="office_vehicle_itinerary">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="office_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="itinerary_code" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="office_vehicle_itinerary" baseColumnNames="office_id"
                                 constraintName="fk_office_vehicle_itinerary__office_id"
                                 referencedTableName="office" referencedColumnNames="id"/>
        <addUniqueConstraint tableName="office_vehicle_itinerary" columnNames="office_id, itinerary_code"
                             constraintName="ux_office_vehicle_itinerary__office_code"/>
    </changeSet>
</databaseChangeLog>
